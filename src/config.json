{
   "version": "0.0.0",
   "language": "lisp",
   "flags": {
      "interactive": true,
      "debug": false,
      "force": false,
      "clear": false
   },
   "implementation": "interpreter",
   "paths": {
      "lib": ".lib",
      "language": "languages/lisp",
      "generated": "parser"
   },
   "formatting": {
      "indent": " //INDENTATION-MARKER// ",
      "dedent": " //DEDENTATION-MARKER// ",
      "indentation": false,
      "newlines": false
   },
   "input": [
      "../examples/in.lsp"
   ],
   "output": "out.cpp",
   "tests": [],
   "ignore": {
      "categories": [
         "ignore",
         "flags",
         "input"
      ],
      "generated": [
         "AST.py",
         "eval.py",
         "parsetable.py"
      ]
   }
}